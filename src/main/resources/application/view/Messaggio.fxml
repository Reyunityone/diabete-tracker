<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="application.controller.MessaggioController"
        spacing="20"
        prefWidth="550"
        prefHeight="400"
        stylesheets="@../css/finestre.css">

    <padding>

        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>

    </padding>


    <Label
            fx:id="nomeLabel"
            styleClass="window-title"/>


    <Label
            text="Messaggio:"
            styleClass="message-label"/>


    <Label
            fx:id="testoLabel"
            wrapText="true"
            maxWidth="490"
            styleClass="message-text"
            VBox.vgrow="ALWAYS"/>


    <Button
            text="Chiudi"
            onAction="#chiudi"
            styleClass="open-button"/>

</VBox>