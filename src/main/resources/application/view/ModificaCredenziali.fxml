<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.controller.ModificaCredenzialiController"
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      prefHeight="350">

    <padding>
        <Insets top="30"
                bottom="30"
                left="40"
                right="40"/>
    </padding>

    <Label text="Modifica credenziali"
           style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

    <Label fx:id="personaLabel"
           text="Nome Cognome"
           style="-fx-font-size: 16px;"/>

    <PasswordField fx:id="vecchieCredenzialiField"
                   promptText="Vecchie credenziali"
                   prefHeight="40"/>

    <PasswordField fx:id="nuoveCredenzialiField"
                   promptText="Nuove credenziali"
                   prefHeight="40"/>

    <VBox spacing="10"
          alignment="CENTER">

        <Button text="Conferma"
                onAction="#handleConferma"
                prefWidth="150"
                prefHeight="40"/>

        <Button text="Annulla"
                onAction="#handleAnnulla"
                prefWidth="150"
                prefHeight="40"/>

    </VBox>

</VBox>