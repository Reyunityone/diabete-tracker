<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.Region?>
<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.controller.StoricoTerapieController"
            prefWidth="700"
            prefHeight="500"
            stylesheets="@../css/finestre.css">

    <VBox spacing="20"
          AnchorPane.topAnchor="25"
          AnchorPane.bottomAnchor="25"
          AnchorPane.leftAnchor="30"
          AnchorPane.rightAnchor="30">

        <HBox alignment="CENTER_LEFT">

            <Label fx:id="titoloLabel"
                   text="Terapie"
                   styleClass="title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                    fx:id="aggiungiButton"
                    text="Aggiungi"
                    styleClass="patient-action-button">

                <graphic>

                    <ImageView
                            fitHeight="25.0"
                            fitWidth="25.0"
                            preserveRatio="true">

                        <Image
                                url="@../images/aggiungi.png"/>

                    </ImageView>

                </graphic>

            </Button>

        </HBox>


        <HBox
                fx:id="aggiungiMenu"
                spacing="10.0"
                alignment="CENTER_RIGHT"
                visible="false"
                managed="false"
                styleClass="mail-menu">

            <!-- NUOVA TERAPIA -->

            <AnchorPane
                    prefWidth="115.0"
                    prefHeight="45.0">

                <Button
                        fx:id="nuovaTerapiaButton"
                        text=" Nuova"
                        prefWidth="115.0"
                        prefHeight="45.0"
                        styleClass="mail-menu-button"
                        AnchorPane.topAnchor="0.0"
                        AnchorPane.leftAnchor="0.0">

                    <graphic>

                        <ImageView
                                fitHeight="20.0"
                                fitWidth="20.0"
                                preserveRatio="true">

                            <Image
                                    url="@../images/aggiungi.png"/>

                        </ImageView>

                    </graphic>

                </Button>

            </AnchorPane>


            <!-- TERAPIA ESISTENTE -->

            <AnchorPane
                    prefWidth="115.0"
                    prefHeight="45.0">

                <Button
                        fx:id="esistenteTerapiaButton"
                        text="Esistente"
                        prefWidth="115.0"
                        prefHeight="45.0"
                        styleClass="mail-menu-button"
                        AnchorPane.topAnchor="0.0"
                        AnchorPane.leftAnchor="0.0">

                    <graphic>

                        <ImageView
                                fitHeight="28.0"
                                fitWidth="28.0"
                                preserveRatio="true">
                            <Image url="@../images/vediPrecedenti.png"/>

                        </ImageView>

                    </graphic>

                </Button>

            </AnchorPane>

        </HBox>

        <TextField fx:id="searchField"
                   promptText="Cerca per nome del farmaco..."
                   prefHeight="42.0"
                   styleClass="search-field"/>


        <ScrollPane fx:id="terapieScrollPane"
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS">

            <content>

                <VBox fx:id="terapieContainer">

                </VBox>

            </content>

        </ScrollPane>

    </VBox>

</AnchorPane>