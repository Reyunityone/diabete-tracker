<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.controller.DiabetologoController"
            prefWidth="1200.0"
            prefHeight="750.0"
            stylesheets="@../css/diabetologo.css">

    <BorderPane
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">

        <!-- ================================================= -->
        <!-- BARRA SUPERIORE -->
        <!-- ================================================= -->

        <top>

            <HBox alignment="CENTER_LEFT"
                  spacing="15.0"
                  prefHeight="90.0"
                  styleClass="top-bar">

                <padding>
                    <Insets left="25.0"
                            right="25.0"
                            top="15.0"
                            bottom="15.0"/>
                </padding>


                <!-- AVATAR -->

                <ImageView fx:id="profileImage"
                           fitHeight="55.0"
                           fitWidth="55.0"
                           preserveRatio="true">

                    <Image url="@../images/avatar.png"/>
                </ImageView>


                <!-- NOME + COGNOME + RUOLO -->

                <VBox spacing="3.0">

                    <Label fx:id="nomeCognomeLabel"
                           text="Nome Cognome"
                           styleClass="profile-name"/>

                    <Label fx:id="ruoloLabel"
                           text="Medico"
                           styleClass="profile-role"/>

                </VBox>


                <!-- SPAZIO -->

                <Region HBox.hgrow="ALWAYS"/>


                <!-- LOGOUT -->

                <Button fx:id="logoutButton"
                        onAction="#handleLogout"
                        styleClass="logout-button">

                    <graphic>

                        <ImageView fitHeight="35.0"
                                   fitWidth="35.0"
                                   preserveRatio="true">

                            <Image url="@../images/logout.png"/>
                        </ImageView>

                    </graphic>

                </Button>

            </HBox>

        </top>


        <!-- ================================================= -->
        <!-- CONTENUTO CENTRALE -->
        <!-- ================================================= -->

        <center>

            <AnchorPane>

                <!-- ================================================= -->
                <!-- CONTENUTO PAZIENTI -->
                <!-- ================================================= -->

                <VBox spacing="20.0"
                      AnchorPane.topAnchor="0.0"
                      AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0"
                      AnchorPane.rightAnchor="0.0">

                    <padding>
                        <Insets top="30.0"
                                bottom="30.0"
                                left="40.0"
                                right="40.0"/>
                    </padding>


                    <!-- TITOLO -->

                    <Label text="Pazienti"
                           styleClass="section-title"/>


                    <!-- RICERCA -->

                    <TextField fx:id="searchField"
                               promptText="Cerca paziente per nome o cognome..."
                               prefHeight="42.0"
                               styleClass="search-field"/>


                    <!-- LISTA PAZIENTI -->

                    <ScrollPane fx:id="pazientiScrollPane"
                                fitToWidth="true"
                                hbarPolicy="NEVER"
                                VBox.vgrow="ALWAYS"
                                styleClass="list-scroll">

                        <VBox fx:id="pazientiContainer"
                              spacing="10.0"
                        >

                            <padding>
                                <Insets top="5.0"
                                        bottom="5.0"
                                        left="5.0"
                                        right="5.0"/>
                            </padding>

                        </VBox>

                    </ScrollPane>

                </VBox>
                
                <!-- ================================================= -->
<!-- MESSAGGI -->
<!-- ================================================= -->

<AnchorPane
        AnchorPane.topAnchor="10.0"
        AnchorPane.rightAnchor="110.0">

    <!-- PULSANTE MESSAGGI -->

    <Button
            fx:id="messaggiButton"
            prefWidth="55.0"
            prefHeight="55.0"
            styleClass="mail-button">

        <graphic>

            <ImageView
                    fitHeight="45.0"
                    fitWidth="45.0"
                    preserveRatio="true">

                <Image url="@../images/messaggio.png"/>

            </ImageView>

        </graphic>

    </Button>


    <!-- PALLINO NOTIFICA -->

    <ImageView
            fx:id="messaggiNotification"
            fitWidth="18"
            fitHeight="18"
            preserveRatio="true"
            visible="false"
            AnchorPane.topAnchor="-2"
            AnchorPane.rightAnchor="-2">

        <Image url="@../images/daLeggere.png"/>

    </ImageView>

</AnchorPane>

            </AnchorPane>

        </center>

    </BorderPane>

</AnchorPane>