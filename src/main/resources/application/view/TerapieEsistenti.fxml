<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.controller.TerapieEsistentiController"
            prefWidth="600"
            prefHeight="450"
            stylesheets="@../css/finestre.css">

    <VBox spacing="20"
          AnchorPane.topAnchor="25"
          AnchorPane.bottomAnchor="25"
          AnchorPane.leftAnchor="30"
          AnchorPane.rightAnchor="30">

        <Label fx:id="titoloLabel"
               text="Terapie esistenti"
               styleClass="title"/>

        <ScrollPane fx:id="terapieScrollPane"
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS">

            <content>

                <VBox fx:id="terapieContainer">

                </VBox>

            </content>

        </ScrollPane>

    </VBox>

</AnchorPane>