<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.controller.AggiungiPersonaController"
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      prefHeight="400">

    <padding>
        <Insets top="30"
                bottom="30"
                left="40"
                right="40"/>
    </padding>

    <Label fx:id="titoloLabel"
           text="Aggiungi"
           style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

    <TextField fx:id="nomeField"
               promptText="Nome"
               prefHeight="40"/>

    <TextField fx:id="cognomeField"
               promptText="Cognome"
               prefHeight="40"/>

    <PasswordField fx:id="credenzialiField"
                   promptText="Credenziali"
                   prefHeight="40"/>

    <VBox spacing="10"
          alignment="CENTER">

        <Button text="Conferma"
                onAction="#handleConferma"
                prefWidth="150"
                prefHeight="40"/>

        <Button text="Annulla"
                onAction="#handleAnnulla"
                prefWidth="150"
                prefHeight="40"/>

    </VBox>

</VBox>