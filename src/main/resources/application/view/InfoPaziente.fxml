<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.controller.InfoPazienteController"
      spacing="12"
      prefWidth="550"
      prefHeight="550"
      stylesheets="@../css/finestre.css">

    <padding>
        <Insets top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>

    <Label fx:id="titoloLabel"
           text="Informazioni paziente"
           styleClass="title"/>

    <Label text="Fattori di rischio"/>

    <!-- CONTENITORE DELLA TEXTAREA E DEL PULSANTE -->
    <AnchorPane>

        <TextArea fx:id="fattoriRischioArea"
                  editable="false"
                  wrapText="true"
                  AnchorPane.topAnchor="0"
                  AnchorPane.bottomAnchor="0"
                  AnchorPane.leftAnchor="0"
                  AnchorPane.rightAnchor="0"/>

        <Button fx:id="fattoriRischioButton"
                text="▼"
                onAction="#apriMenuFattoriRischio"
                AnchorPane.rightAnchor="5"
                AnchorPane.bottomAnchor="5"
                prefWidth="25"
                prefHeight="25"
                minWidth="25"
                minHeight="25"
                maxWidth="25"
                maxHeight="25"
                styleClass="dropdown-button"/>
    </AnchorPane>

    <Label text="Pregresse patologie"/>

    <TextArea fx:id="patologieArea"
              wrapText="true"/>

    <Label text="Comorbidità presenti"/>

    <TextArea fx:id="comorbiditaArea"
              wrapText="true"/>

    <Label text="Dettagli"/>

    <TextArea fx:id="dettagliArea"
              wrapText="true"/>

    <Button fx:id="salvaButton"
            text="Salva"/>

</VBox>