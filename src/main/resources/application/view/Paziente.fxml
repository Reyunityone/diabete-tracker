<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<AnchorPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="application.controller.PazienteController"

        prefWidth="1200.0"
        prefHeight="750.0"

        stylesheets="@../css/paziente.css">


    <BorderPane
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">


        <!-- ================================================= -->
        <!-- BARRA SUPERIORE -->
        <!-- ================================================= -->

        <top>

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="15.0"
                    prefHeight="90.0"
                    styleClass="top-bar">

                <padding>
                    <Insets
                            left="25.0"
                            right="25.0"
                            top="15.0"
                            bottom="15.0"/>
                </padding>


                <!-- ================================================= -->
                <!-- AVATAR -->
                <!-- ================================================= -->

                <ImageView
                        fx:id="profileImage"
                        fitHeight="55.0"
                        fitWidth="55.0"
                        preserveRatio="true">

                    <Image
                            url="@../images/avatar.png"/>
                </ImageView>


                <!-- ================================================= -->
                <!-- NOME + RUOLO -->
                <!-- ================================================= -->

                <VBox spacing="3.0">

                    <Label
                            fx:id="nomeCognomeLabel"
                            text="Nome Cognome"
                            styleClass="profile-name"/>

                    <Label
                            fx:id="ruoloLabel"
                            text="Paziente"
                            styleClass="profile-role"/>

                </VBox>


                <!-- SPAZIO -->

                <Region HBox.hgrow="ALWAYS"/>


                <!-- ================================================= -->
                <!-- LOGOUT -->
                <!-- ================================================= -->

                <Button
                        fx:id="logoutButton"
                        onAction="#handleLogout"
                        styleClass="logout-button">

                    <graphic>

                        <ImageView
                                fitHeight="35.0"
                                fitWidth="35.0"
                                preserveRatio="true">

                            <Image
                                    url="@../images/logout.png"/>
                        </ImageView>

                    </graphic>

                </Button>

            </HBox>

        </top>


        <!-- ================================================= -->
        <!-- CONTENUTO CENTRALE -->
        <!-- ================================================= -->

        <center>

            <AnchorPane>


                <!-- ================================================= -->
                <!-- SEZIONI PAZIENTE -->
                <!-- ================================================= -->

                <VBox
                        spacing="18.0"

                        AnchorPane.topAnchor="85.0"
                        AnchorPane.bottomAnchor="25.0"
                        AnchorPane.leftAnchor="40.0"
                        AnchorPane.rightAnchor="40.0">

                    <padding>

                        <Insets
                                top="15.0"
                                bottom="15.0"
                                left="5.0"
                                right="5.0"/>

                    </padding>


                    <!-- ================================================= -->
                    <!-- RILEVAZIONI GIORNALIERE -->
                    <!-- ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="15.0"
                            prefHeight="130.0"
                            styleClass="patient-section">


                        <VBox
                                spacing="5.0"
                                alignment="CENTER_LEFT">

                            <Label
                                    text="Rilevazioni Giornaliere"
                                    styleClass="section-title"/>

                            <Label
                                    text="Inserisci e consulta le tue rilevazioni."
                                    styleClass="section-description"/>

                        </VBox>


                        <Region HBox.hgrow="ALWAYS"/>


                        <!-- AGGIUNGI -->

                        <Button
                                fx:id="aggiungiRilevazioneButton"
                                text="Aggiungi"
                                onAction="#apriAggiungiRilevazione"
                                styleClass="patient-action-button">

                            <graphic>

                                <ImageView
                                        fitHeight="25.0"
                                        fitWidth="25.0"
                                        preserveRatio="true">

                                    <Image
                                            url="@../images/aggiungi.png"/>
                                </ImageView>

                            </graphic>

                        </Button>


                        <!-- VEDI PRECEDENTI -->

                        <Button
                                fx:id="precedentiRilevazioniButton"
                                text="Vedi Precedenti"
                                onAction="#apriStoricoRilevazioni"
                                styleClass="patient-action-button">

                            <graphic>

                                <ImageView
                                        fitHeight="25.0"
                                        fitWidth="25.0"
                                        preserveRatio="true">

                                    <Image
                                            url="@../images/vediPrecedenti.png"/>
                                </ImageView>

                            </graphic>

                        </Button>


                        <!-- INFO -->

                        <Button
                                fx:id="infoRilevazioniButton"
                                styleClass="patient-info-button">

                            <graphic>

                                <ImageView
                                        fitHeight="25.0"
                                        fitWidth="25.0"
                                        preserveRatio="true">

                                    <Image
                                            url="@../images/info.png"/>
                                </ImageView>

                            </graphic>

                        </Button>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- ASSUNZIONE FARMACI -->
                    <!-- ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="15.0"
                            prefHeight="130.0"
                            styleClass="patient-section">


                        <VBox
                                spacing="5.0"
                                alignment="CENTER_LEFT">

                            <Label
                                    text="Assunzione Farmaci"
                                    styleClass="section-title"/>

                            <Label
                                    text="Gestisci i farmaci assunti."
                                    styleClass="section-description"/>

                        </VBox>


                        <Region HBox.hgrow="ALWAYS"/>


                        <!-- AGGIUNGI -->

                        <Button
                                fx:id="aggiungiSintomoButton"
                                text="Aggiungi"
                                onAction="#apriAggiungiSintomo"
                                styleClass="patient-action-button">

                            <graphic>

                                <ImageView
                                        fitHeight="25.0"
                                        fitWidth="25.0"
                                        preserveRatio="true">

                                    <Image
                                            url="@../images/aggiungi.png"/>
                                </ImageView>

                            </graphic>

                        </Button>


                        <!-- VEDI PRECEDENTI -->

                        <Button
                                fx:id="precedentiSintomiButton"
                                text="Vedi Precedenti"
                                onAction="#apriStoricoSintomi"
                                styleClass="patient-action-button">

                            <graphic>

                                <ImageView
                                        fitHeight="25.0"
                                        fitWidth="25.0"
                                        preserveRatio="true">

                                    <Image
                                            url="@../images/vediPrecedenti.png"/>
                                </ImageView>

                            </graphic>

                        </Button>


                        <!-- INFO -->

                        <Button
                                fx:id="infoSintomiButton"
                                styleClass="patient-info-button">

                            <graphic>

                                <ImageView
                                        fitHeight="25.0"
                                        fitWidth="25.0"
                                        preserveRatio="true">

                                    <Image
                                            url="@../images/info.png"/>
                                </ImageView>

                            </graphic>

                        </Button>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- SEGNALAZIONI -->
                    <!-- ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="15.0"
                            prefHeight="130.0"
                            styleClass="patient-section">


                        <VBox
                                spacing="5.0"
                                alignment="CENTER_LEFT">

                            <Label
                                    text="Segnalazioni"
                                    styleClass="section-title"/>

                            <Label
                                    text="Invia e consulta le tue segnalazioni."
                                    styleClass="section-description"/>

                        </VBox>


                        <Region HBox.hgrow="ALWAYS"/>


                        <!-- AGGIUNGI -->

                        <Button
                                fx:id="aggiungiSegnalazioneButton"
                                text="Aggiungi"
                                onAction="#apriAggiungiSegnalazione"
                                styleClass="patient-action-button">

                            <graphic>

                                <ImageView
                                        fitHeight="25.0"
                                        fitWidth="25.0"
                                        preserveRatio="true">

                                    <Image
                                            url="@../images/aggiungi.png"/>
                                </ImageView>

                            </graphic>

                        </Button>


                        <!-- VEDI PRECEDENTI -->

                        <Button
                                fx:id="precedentiSegnalazioniButton"
                                text="Vedi Precedenti"
                                onAction="#apriStoricoSegnalazioni"
                                styleClass="patient-action-button">

                            <graphic>

                                <ImageView
                                        fitHeight="25.0"
                                        fitWidth="25.0"
                                        preserveRatio="true">

                                    <Image
                                            url="@../images/vediPrecedenti.png"/>
                                </ImageView>

                            </graphic>

                        </Button>


                        <!-- INFO -->

                        <Button
                                fx:id="infoSegnalazioniButton"
                                styleClass="patient-info-button">

                            <graphic>

                                <ImageView
                                        fitHeight="25.0"
                                        fitWidth="25.0"
                                        preserveRatio="true">

                                    <Image
                                            url="@../images/info.png"/>
                                </ImageView>

                            </graphic>

                        </Button>

                    </HBox>

                </VBox>
                
                <!-- ================================================= -->
<!-- MESSAGGI -->
<!-- ================================================= -->

<AnchorPane
        AnchorPane.topAnchor="10.0"
        AnchorPane.rightAnchor="110.0">

    <!-- PULSANTE MESSAGGI -->

    <Button
            fx:id="messaggiButton"
            prefWidth="55.0"
            prefHeight="55.0"
            styleClass="mail-button">

        <graphic>

            <ImageView
                    fitHeight="45.0"
                    fitWidth="45.0"
                    preserveRatio="true">

                <Image
                        url="@../images/messaggio.png"/>

            </ImageView>

        </graphic>

    </Button>


    <!-- PALLINO NOTIFICA -->

    <ImageView
            fx:id="messaggiNotification"
            fitHeight="15.0"
            fitWidth="15.0"
            preserveRatio="true"
            visible="false"
            AnchorPane.topAnchor="-2.0"
            AnchorPane.rightAnchor="-2.0">

        <Image
                url="@../images/daLeggere.png"/>

    </ImageView>

</AnchorPane>

            </AnchorPane>

        </center>

    </BorderPane>

</AnchorPane>